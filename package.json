{
  "name": "cheap-escape",
  "version": "0.1.0",
  "private": true,
  "description": "Door-to-door cheapest spontaneous trips from Salzburg: open-jaw flights, bus/train links, car + parking vs public transport, travel cards.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "snapshot": "NODE_USE_ENV_PROXY=1 node --no-warnings src/fetch/snapshot.js",
    "build": "node src/app/build.js",
    "bundle": "node src/app/bundle-refresh.js",
    "search": "node src/cli.js",
    "alerts": "node src/alerts.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
